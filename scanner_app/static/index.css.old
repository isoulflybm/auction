/*
 *
 */
 
img {
   width: 100px;
}

h2 {
    margin: 10px;
    padding: 4px;
    box-sizing: border-box;
}

h2 a {
    color: rgb(93, 89, 108);
    cursor: pointer;
    text-decoration: none;
    font-family: "Public Sans";
    font-size: 22px;
    font-weight: 700;
}

h2 a:hover {
    text-decoration: underline;
}

.lot_id {
   font-weight: bold;
}
